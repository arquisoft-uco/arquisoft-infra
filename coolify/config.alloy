// ============================================================
// Grafana Alloy — configuración para servidor Coolify
// ============================================================
// Pipeline: Docker socket → filtra backend → extrae labels → Loki
// Métricas del sistema (node_exporter) → Prometheus
//
// Variables requeridas (pasadas por docker-compose):
//   LOKI_URL       — ej. http://loki:3100/loki/api/v1/push          (red local)
//                         http://<SERVER2_PRIVATE_IP>:3100/...       (servidor remoto)
//   PROMETHEUS_URL — ej. http://prometheus:9090/api/v1/write         (red local)
//                         http://<SERVER2_PRIVATE_IP>:9090/...       (servidor remoto)
// ============================================================

// 1. Descubrimiento de contenedores Docker del servidor
discovery.docker "contenedores_servidor" {
	host = "unix:///var/run/docker.sock"
}

// 2. Filtra contenedores por el label Docker "monitoring=arquisoft-backend".
//    Coolify genera nombres de contenedor aleatorios, por lo que no es posible
//    filtrar por container_name. En su lugar se usa un label personalizado que
//    el equipo agrega en Coolify → app → Configuration → Labels:
//      monitoring=arquisoft-backend
//    Los puntos y guiones en nombres de label se convierten a "_" en el meta-label.
//    IMPORTANTE: los __meta_docker_* solo están disponibles en discovery.relabel
//    con relabel_rules (argumento de loki.source.docker) — NO en loki.relabel.
discovery.relabel "docker_metadata" {
	targets = []

	// Descarta todos los contenedores que NO tengan el label monitoring=arquisoft-backend
	rule {
		source_labels = ["__meta_docker_container_label_monitoring"]
		regex         = "arquisoft-backend"
		action        = "keep"
	}

	// Fija el label "container" a un valor estable para las queries en Loki,
	// independientemente del nombre aleatorio que Coolify asigne al contenedor.
	rule {
		target_label = "container"
		replacement  = "arquisoft-backend"
	}
}

// 3. Pipeline de procesamiento: parsea JSON de Spring Boot (perfil prod),
//    extrae level como stream label y descarta DEBUG/TRACE.
loki.process "extract_labels" {
	forward_to = [loki.write.loki_out.receiver]

	// Extrae campos del JSON producido por StructuredLogEncoder
	stage.json {
		expressions = {
			level   = "level",
			message = "message",
			logger  = "logger_name",
			traceId = "traceId",
			userId  = "userId",
		}
	}

	// Promueve level a stream label (baja cardinalidad → usable en {})
	stage.labels {
		values = {level = ""}
	}

	// Descarta DEBUG y TRACE — no aportan valor en prod y aumentan el volumen
	stage.drop {
		expression          = "\"level\":\"(?:DEBUG|TRACE)\""
		drop_counter_reason = "debug_trace_noise"
	}
}

// 4. Fuente de logs: captura stdout de contenedores vía Docker socket.
//    relabel_rules aplica las reglas de discovery.relabel ANTES de enviar
//    a loki.process — es aquí donde los __meta_docker_* están disponibles.
loki.source.docker "backend_logs" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.contenedores_servidor.targets
	forward_to    = [loki.process.extract_labels.receiver]
	relabel_rules = discovery.relabel.docker_metadata.rules
}

// 5. Envío a Loki — endpoint configurado vía variable de entorno LOKI_URL.
//    Permite apuntar a Loki local (misma red Docker) o a un servidor remoto
//    sin cambiar este archivo.
loki.write "loki_out" {
	endpoint {
		url = env("LOKI_URL")
	}
	external_labels = {
		job = "backend-java-coolify",
	}
}

// ── MÉTRICAS ──────────────────────────────────────────────────────────────────

// 6. Exporta métricas del sistema (CPU, RAM, disco, red) como node_exporter
prometheus.exporter.unix "node_stats" { }

// 7. Scrape de métricas del sistema
prometheus.scrape "scrape_node" {
	targets    = prometheus.exporter.unix.node_stats.targets
	forward_to = [prometheus.remote_write.prometheus_out.receiver]
}

// 8. Envío a Prometheus — endpoint configurado vía variable de entorno PROMETHEUS_URL.
//    Para push cross-server, Prometheus debe exponer el puerto 9090 en el servidor
//    de observabilidad y la IP de Server 1 debe estar permitida en el firewall.
prometheus.remote_write "prometheus_out" {
	endpoint {
		url = env("PROMETHEUS_URL")
	}
}
