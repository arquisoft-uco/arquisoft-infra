# ==============================================================================
# Arquisoft IaC — Variables de entorno (fuente única para todos los componentes)
# ==============================================================================
# Copiar a .env: cp .env.example .env  (o ejecutar ./setup-env.sh)
# NUNCA versionar el .env con valores reales.
# Los valores CHANGE_ME se autogeneran con ./setup-env.sh
# ==============================================================================

# ---------- Global ----------
DOMAIN=arquisoft.localhost
# ACME_EMAIL solo es obligatorio en prod (registro Let's Encrypt)
ACME_EMAIL=admin@tu-dominio.com
TIMEZONE=America/Bogota

# ---------- Multi-servidor (single-server: dejar los nombres de servicio) ----------
# En multi-servidor, reemplazar por la IP privada del servidor de datos.
POSTGRES_HOST=postgres
RABBITMQ_HOST=rabbitmq
REDIS_HOST=redis
KEYCLOAK_HOST=keycloak
# IP privada del servidor de observabilidad (recibe push de Alloy). Single-server: 127.0.0.1
OBS_BIND_IP=127.0.0.1

# ---------- PostgreSQL (app) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=postgres
APP_DB_USER=arquisoft_user
APP_DB_PASSWORD=CHANGE_ME

# ---------- Keycloak ----------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_NAME=keycloak
# Usuario semilla del realm arquisoft
KC_REALM_ADMIN_EMAIL=admin@uco.edu.co
KC_REALM_ADMIN_FIRST_NAME=Admin
KC_REALM_ADMIN_LAST_NAME=Sistema
KC_REALM_ADMIN_PASSWORD=CHANGE_ME

# ---------- RabbitMQ ----------
RABBITMQ_USER=arquisoft
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=arquisoft

# ---------- Redis ----------
REDIS_PASSWORD=CHANGE_ME

# ---------- MinIO ----------
MINIO_ROOT_USER=arquisoft
MINIO_ROOT_PASSWORD=CHANGE_ME
# Cuenta de servicio del backend (la crea minio-init)
MINIO_ACCESS_KEY=arquisoft-backend
MINIO_SECRET_KEY=CHANGE_ME
MINIO_ENDPOINT=http://minio:9000

# ---------- Grafana / Observabilidad ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ---------- BasicAuth de consolas admin (Traefik dashboard, MinIO, RabbitMQ) ----------
ADMIN_AUTH_USER=admin
ADMIN_AUTH_PASSWORD=CHANGE_ME

# ---------- Backend (imagen externa) ----------
BACKEND_IMAGE=
BACKEND_TAG=latest
SPRING_PROFILES_ACTIVE=prod
KEYCLOAK_REALM=arquisoft
KEYCLOAK_CLIENT_ID=arquisoft-api
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70.0 -XX:InitialRAMPercentage=40.0"
# Alloy -> observabilidad (single-server: nombres de servicio; multi: IP privada del obs)
LOKI_URL=http://loki:3100/loki/api/v1/push
PROMETHEUS_URL=http://prometheus:9090/api/v1/write
BACKEND_TARGET=arquisoft-backend:8080

# ---------- Frontend (imagen externa) ----------
FRONTEND_IMAGE=
FRONTEND_TAG=latest
FRONTEND_PORT=80
