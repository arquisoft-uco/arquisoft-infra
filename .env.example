# ==============================================================================
# Arquisoft - Variables de Entorno
# ==============================================================================
# Copiar este archivo a .env y reemplazar los valores placeholder
# NUNCA versionar el archivo .env con valores reales
#
# Uso: ./scripts/setup-env.sh (genera .env interactivamente)
# ==============================================================================

# ==============================================================================
# PostgreSQL - Base de datos transaccional
# ==============================================================================
POSTGRES_USER=arquisoft
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
POSTGRES_DB=arquisoft

# ==============================================================================
# RabbitMQ - Message Queue
# ==============================================================================
RABBITMQ_USER=arquisoft
RABBITMQ_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
RABBITMQ_VHOST=arquisoft

# ==============================================================================
# MinIO - Object Storage (S3-compatible)
# ==============================================================================
MINIO_ROOT_USER=arquisoft
MINIO_ROOT_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD

# ==============================================================================
# Keycloak - Identity Provider (Master Realm)
# ==============================================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD

# ==============================================================================
# Keycloak - Administrador del Realm Arquisoft (usuario semilla)
# ==============================================================================
KC_REALM_ADMIN_EMAIL=admin@uco.edu.co
KC_REALM_ADMIN_FIRST_NAME=Admin
KC_REALM_ADMIN_LAST_NAME=Sistema
KC_REALM_ADMIN_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD

# ==============================================================================
# Grafana - Dashboards y visualización
# ==============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
GRAFANA_ROOT_URL=http://localhost:3000

# ==============================================================================
# Dominio - Usado por Traefik para routing y CORS
# ==============================================================================
# Desarrollo: arquisoft.localhost
# Producción: tu-dominio.com (ej: unyai.duckdns.org)
DOMAIN=arquisoft.localhost

# ==============================================================================
# ACME / Let's Encrypt (solo producción)
# ==============================================================================
# Obligatorio cuando DOMAIN no es *.localhost (modo producción).
# Let's Encrypt usa este email para notificaciones de expiración de certificados.
# setup-env.sh lo configura automáticamente al detectar dominio de producción.
# Descomentar y configurar manualmente si no se usa setup-env.sh:
# ACME_EMAIL=admin@tu-dominio.com

# ==============================================================================
# Prometheus - Basic Auth (solo producción)
# ==============================================================================
# Credencial usada por el healthcheck de Prometheus cuando web.yml está habilitado.
# setup-env.sh lo genera automáticamente en modo producción.
# PROMETHEUS_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD

# ==============================================================================
# BasicAuth / Traefik (generado automáticamente)
# ==============================================================================
# El archivo configs/traefik/certs/.htpasswd es generado por setup-env.sh.
# Contiene credenciales BasicAuth para consolas administrativas (Traefik, MinIO).
# NO versionar el archivo .htpasswd con credenciales reales.
# Referencia: configs/traefik/certs/.htpasswd.example

# ==============================================================================
# Instrucciones para generar contraseñas seguras:
# ==============================================================================
# Linux/macOS:
#   openssl rand -base64 32
#
# Windows PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
#
# O usa el script: ./scripts/setup-env.sh
# ==============================================================================
