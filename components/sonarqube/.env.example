# =============================================================================
# Componente sonarqube — .env LOCAL de esta carpeta
# =============================================================================
# Herramienta aislada: NO usa el .env de la raíz del repo.
#   cp .env.example .env    # y rellenar los CHANGE_ME
# docker compose lee automáticamente el .env de esta carpeta.
#
# Generar una contraseña segura:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# =============================================================================

# Dominio base. La UI queda en https://sonar.${DOMAIN}
DOMAIN=arquisoft.top
TIMEZONE=America/Bogota

# ---------- Base de datos dedicada de SonarQube ----------
SONAR_DB_USER=sonarqube
SONAR_DB_PASSWORD=CHANGE_ME
SONAR_DB_NAME=sonarqube
