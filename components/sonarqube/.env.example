# =============================================================================
# Componente sonarqube — .env LOCAL de esta carpeta
# =============================================================================
# Herramienta aislada: docker compose lee SOLO el .env de esta carpeta.
# En el servidor ese .env se genera desde Doppler (arquisoft-infra/test), con las
# claves que declara este archivo (docs/SECRETOS.md):
#   ./scripts/fetch-secrets.sh fetch && ./scripts/fetch-secrets.sh tools sonarqube
# Sin baúl (local): cp .env.example .env y rellenar los CHANGE_ME.
#
# Generar una contraseña segura:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# =============================================================================

# Dominio base. La UI queda en https://sonar.${DOMAIN}
DOMAIN=arquisoft.top
TIMEZONE=America/Bogota

# ---------- Base de datos dedicada de SonarQube ----------
SONAR_DB_USER=sonarqube
SONAR_DB_PASSWORD=CHANGE_ME
SONAR_DB_NAME=sonarqube
