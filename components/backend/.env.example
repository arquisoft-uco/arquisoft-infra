# Componente backend + alloy — variables relevantes
# La fuente real es el .env de la raíz del repo.
DOMAIN=arquisoft.localhost

# Imagen del backend (se construye/publica en el repo arquisoft-backend)
BACKEND_IMAGE=ghcr.io/arquisoft-uco/arquisoft-backend
BACKEND_TAG=sha-f906ef4
SPRING_PROFILES_ACTIVE=prod

# Hosts de dependencias (single-server = nombres de servicio; multi-servidor = IP privada)
POSTGRES_HOST=postgres
RABBITMQ_HOST=rabbitmq
REDIS_HOST=redis
KEYCLOAK_HOST=keycloak

# Credenciales (compartidas con los componentes de datos)
APP_DB_USER=arquisoft_user
APP_DB_PASSWORD=CHANGE_ME
RABBITMQ_USER=arquisoft
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_PORT=5672
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379
# Usuario Redis: el componente usa --requirepass (usuario por defecto "default")
REDIS_USER=default
# La imagen usa el vhost por defecto "/" (fijo en application.yml). El componente
# rabbitmq aprovisiona el usuario con permisos sobre "/" (ver RABBITMQ_VHOST=/ en la raíz).

# Keycloak (cliente del backend)
KEYCLOAK_REALM=arquisoft
KEYCLOAK_CLIENT_ID=arquisoft-api
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# MinIO (cuenta de servicio del backend)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=arquisoft-backend
MINIO_SECRET_KEY=CHANGE_ME

# Alloy -> observabilidad (single-server = nombres de servicio; multi = IP privada del obs)
LOKI_URL=http://loki:3100/loki/api/v1/push
PROMETHEUS_URL=http://prometheus:9090/api/v1/write
BACKEND_TARGET=arquisoft-backend:8080
