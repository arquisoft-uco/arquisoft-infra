# Componente observability — variables relevantes
# La fuente real es el .env de la raíz del repo.
DOMAIN=arquisoft.localhost
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Multi-servidor: IP privada del servidor de observabilidad (recibe push de Alloy).
# Single-server/dev: dejar en 127.0.0.1.
OBS_BIND_IP=127.0.0.1
