# Componente duckdns — variables relevantes
# La fuente real es el .env de la raíz del repo.

# Subdominio(s) sin el sufijo .duckdns.org. Para unyai.duckdns.org -> "unyai".
DUCKDNS_SUBDOMAINS=unyai
# Token de la cuenta de DuckDNS (https://www.duckdns.org, tras iniciar sesión).
DUCKDNS_TOKEN=CHANGE_ME
# ipv4 | ipv6 | both. ipv4 deja que DuckDNS detecte la IP pública de origen.
DUCKDNS_UPDATE_IP=ipv4
