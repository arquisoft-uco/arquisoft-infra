{
  "realm": "${KEYCLOAK_REALM}",
  "enabled": true,
  "displayName": "Arquisoft - UCO",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>Arquisoft - UCO</span></div>",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "passwordPolicy": "length(8) and notUsername and specialChars(1) and digits(1) and upperCase(1)",
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "roles": {
    "realm": [
      {
        "name": "ESTUDIANTE",
        "description": "Usuario estudiante que desarrolla su proyecto de grado"
      },
      {
        "name": "ASESOR",
        "description": "Docente que guía y supervisa proyectos de grado"
      },
      {
        "name": "ASESOR_FICHA",
        "description": "Responsable de evaluación y seguimiento de fichas de perfil"
      },
      {
        "name": "COORDINADOR",
        "description": "Administrador del programa académico"
      },
      {
        "name": "JURADO",
        "description": "Evaluador final de proyectos de grado"
      },
      {
        "name": "BIBLIOTECARIO",
        "description": "Encargado de custodia y consulta de PG finalizados"
      },
      {
        "name": "REP_COMITE_CURRICULO",
        "description": "Representante del comité de currículo"
      },
      {
        "name": "ADMINISTRADOR",
        "description": "Gestor del sistema y configuraciones"
      }
    ]
  },
  "clients": [
    {
      "clientId": "arquisoft-frontend",
      "name": "Arquisoft Frontend",
      "description": "Aplicación SPA de Arquisoft",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:4200/*",
        "https://${DOMAIN}/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:4200",
        "https://${DOMAIN}"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email"
      ]
    },
    {
      "clientId": "${KEYCLOAK_CLIENT_ID}",
      "name": "Arquisoft Backend",
      "description": "API Backend de Arquisoft",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email"
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "role_list",
    "profile",
    "email",
    "roles",
    "web-origins"
  ],
  "users": [
    {
      "username": "${KC_REALM_ADMIN_EMAIL}",
      "email": "${KC_REALM_ADMIN_EMAIL}",
      "emailVerified": true,
      "enabled": true,
      "firstName": "${KC_REALM_ADMIN_FIRST_NAME}",
      "lastName": "${KC_REALM_ADMIN_LAST_NAME}",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_REALM_ADMIN_PASSWORD}",
          "temporary": true
        }
      ],
      "realmRoles": [
        "ADMINISTRADOR"
      ]
    }
  ],
  "identityProviders": [],
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "rsa-generated",
        "providerId": "rsa-generated",
        "config": {
          "priority": ["100"],
          "keySize": ["4096"],
          "algorithm": ["RS256"]
        }
      },
      {
        "name": "hmac-generated",
        "providerId": "hmac-generated",
        "config": {
          "priority": ["100"],
          "algorithm": ["HS256"]
        }
      }
    ]
  }
}
