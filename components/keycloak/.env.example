# Componente keycloak — variables relevantes
# La fuente real es el .env de la raíz del repo.
DOMAIN=arquisoft.localhost
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# Base de datos dedicada de Keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_NAME=keycloak

# Usuario semilla del realm arquisoft (usado por el realm template)
KC_REALM_ADMIN_EMAIL=admin@uco.edu.co
KC_REALM_ADMIN_FIRST_NAME=Admin
KC_REALM_ADMIN_LAST_NAME=Sistema
KC_REALM_ADMIN_PASSWORD=CHANGE_ME
