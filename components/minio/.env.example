# Componente minio — variables relevantes
# La fuente real es el .env de la raíz del repo.
DOMAIN=arquisoft.localhost
MINIO_ROOT_USER=arquisoft
MINIO_ROOT_PASSWORD=CHANGE_ME

# Cuenta de servicio para el backend (la crea minio-init si están definidas)
MINIO_ACCESS_KEY=arquisoft-backend
MINIO_SECRET_KEY=CHANGE_ME

TIMEZONE=America/Bogota
