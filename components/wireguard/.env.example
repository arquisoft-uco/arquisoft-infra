# WireGuard VPN — Acceso seguro a infraestructura (BD, monitoring, APIs internas)
# Solo definir si se deploya desde docker-compose standalone; Terraform maneja estas vars

# Dominio/IP pública del servidor WireGuard (DNS o IP del servidor remoto)
WIREGUARD_HOST=vpn.arquisoft.top

# Rango de IPs de clientes VPN (subnet privada, ej. 10.0.0.0/24)
WIREGUARD_SUBNET=10.0.0.0/24

# Puertos de escucha en el host
WIREGUARD_PORT=51820

# Modo (server | client). En este repo, siempre 'server'
WIREGUARD_MODE=server

# Número máximo de clientes simultaneados (hardlimit)
MAX_CLIENTS=50
