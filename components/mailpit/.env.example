# =============================================================================
# Componente mailpit — .env LOCAL de esta carpeta
# =============================================================================
# Servicio auxiliar aislado: NO usa el .env de la raíz del repo.
#   cp .env.example .env    # y rellenar los CHANGE_ME
# docker compose lee automáticamente el .env de esta carpeta.
# =============================================================================

# Dominio base. La bandeja web queda en https://mailpit.${DOMAIN}
DOMAIN=arquisoft.top
TIMEZONE=America/Bogota

# ---------- Credenciales SMTP (las usa arquisoft-backend) ----------
# Deben coincidir EXACTAMENTE con MAIL_USERNAME / MAIL_PASSWORD del backend
# (secretos de GitHub). ./setup.sh las escribe en config/smtp-auth.txt.
MAIL_USERNAME=arquisoft_backend
MAIL_PASSWORD=CHANGE_ME

# ---------- Credenciales de la bandeja web ----------
# Protegen https://mailpit.${DOMAIN} y la API. Son propias del componente: no
# tienen relación con ADMIN_AUTH_* del .env de la raíz.
MAILPIT_UI_USER=admin
MAILPIT_UI_PASSWORD=CHANGE_ME

# ---------- Retención (evita que el volumen crezca sin control) ----------
# Máximo de mensajes guardados; al superarlo se descartan los más antiguos.
MAILPIT_MAX_MESSAGES=2000
# Antigüedad máxima de un mensaje (h = horas). 168h = 7 días.
MAILPIT_MAX_AGE=168h
