# ==============================================================================
# .gitignore — arquisoft-infra (Infraestructura Docker Compose)
# ==============================================================================

# Environment variables (secrets)
.env
.env.prod
.env.local

# Traefik ACME certificates
acme.json

# Traefik config files (generated from .template by start.sh)
configs/traefik/dynamic.yaml
configs/traefik/dynamic/dynamic.yaml
configs/traefik/dynamic-prod/routing.yaml
configs/traefik/traefik-prod.yaml

# Keycloak realm (generated from .template by start.sh)
configs/keycloak/realm-arquisoft.json

# RabbitMQ definitions (generated from .template by start.sh)
configs/rabbitmq/definitions.json

# Basic Auth credentials (generated with htpasswd)
configs/traefik/certs/.htpasswd

# Prometheus web config with auth (generated by setup-env.sh)
configs/prometheus/web.yml

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Docker volumes (local)
data/

# Temporary files
*.tmp
*.temp
*.bak
