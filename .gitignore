# ==============================================================================
# .gitignore — arquisoft-infra (Infraestructura Docker Compose)
# ==============================================================================

# Environment variables (secrets)
.env
.env.prod
.env.local

# Traefik ACME certificates
acme.json

# Archivos generados desde .template por deploy.sh (NO versionar)
components/proxy/config/traefik.yml
components/proxy/config/dynamic/.htpasswd
components/keycloak/config/realm-arquisoft.json
components/rabbitmq/config/definitions.json

# Backups de bases de datos / volúmenes
backups/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Docker volumes (local)
data/

# Temporary files
*.tmp
*.temp
*.bak

# Terraform (ver también terraform/.gitignore)
terraform/.terraform/
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/terraform.tfstate.d/
