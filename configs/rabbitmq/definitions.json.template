{
  "rabbit_version": "3.12.0",
  "vhosts": [
    {
      "name": "arquisoft"
    }
  ],
  "permissions": [
    {
      "user": "${RABBITMQ_USER}",
      "vhost": "arquisoft",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "exchanges": [
    {
      "name": "arquisoft.events",
      "vhost": "arquisoft",
      "type": "topic",
      "durable": true,
      "auto_delete": false
    },
    {
      "name": "arquisoft.events.dlx",
      "vhost": "arquisoft",
      "type": "topic",
      "durable": true,
      "auto_delete": false
    }
  ],
  "queues": [
    {
      "name": "arquisoft.notificaciones",
      "vhost": "arquisoft",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "arquisoft.events.dlx",
        "x-dead-letter-routing-key": "notificaciones.dlq"
      }
    },
    {
      "name": "arquisoft.evaluaciones",
      "vhost": "arquisoft",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "arquisoft.events.dlx",
        "x-dead-letter-routing-key": "evaluaciones.dlq"
      }
    },
    {
      "name": "arquisoft.artefactos",
      "vhost": "arquisoft",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "arquisoft.events.dlx",
        "x-dead-letter-routing-key": "artefactos.dlq"
      }
    },
    {
      "name": "arquisoft.fichas",
      "vhost": "arquisoft",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "arquisoft.events.dlx",
        "x-dead-letter-routing-key": "fichas.dlq"
      }
    },
    {
      "name": "arquisoft.proyectos",
      "vhost": "arquisoft",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "arquisoft.events.dlx",
        "x-dead-letter-routing-key": "proyectos.dlq"
      }
    },
    {
      "name": "arquisoft.dlq",
      "vhost": "arquisoft",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "arquisoft.events",
      "vhost": "arquisoft",
      "destination": "arquisoft.notificaciones",
      "destination_type": "queue",
      "routing_key": "notificacion.#"
    },
    {
      "source": "arquisoft.events",
      "vhost": "arquisoft",
      "destination": "arquisoft.evaluaciones",
      "destination_type": "queue",
      "routing_key": "evaluacion.#"
    },
    {
      "source": "arquisoft.events",
      "vhost": "arquisoft",
      "destination": "arquisoft.artefactos",
      "destination_type": "queue",
      "routing_key": "artefacto.#"
    },
    {
      "source": "arquisoft.events",
      "vhost": "arquisoft",
      "destination": "arquisoft.fichas",
      "destination_type": "queue",
      "routing_key": "ficha.#"
    },
    {
      "source": "arquisoft.events",
      "vhost": "arquisoft",
      "destination": "arquisoft.proyectos",
      "destination_type": "queue",
      "routing_key": "proyecto.#"
    },
    {
      "source": "arquisoft.events.dlx",
      "vhost": "arquisoft",
      "destination": "arquisoft.dlq",
      "destination_type": "queue",
      "routing_key": "#"
    }
  ]
}
