# =============================================
# Traefik Static Configuration - Production
# =============================================
# TEMPLATE: Este archivo es procesado por envsubst en start.sh
# Requiere: ACME_EMAIL
# Genera: configs/traefik/traefik-prod.yaml

# API & Dashboard
api:
  dashboard: true
  insecure: false

# Entrypoints
entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"
    http:
      tls:
        certResolver: letsencrypt
  metrics:
    address: ":8082"

# Providers
providers:
  docker:
    exposedByDefault: false
    network: arquisoft-network
  file:
    directory: /etc/traefik/dynamic
    watch: true

# Let's Encrypt
certificatesResolvers:
  letsencrypt:
    acme:
      email: ${ACME_EMAIL}
      storage: /letsencrypt/acme.json
      httpChallenge:
        entryPoint: web

# Logging (WARN en producción para reducir ruido)
log:
  level: WARN
  format: json

accessLog:
  format: json
  filePath: /var/log/traefik/access.log
  bufferingSize: 100

# Ping for healthcheck
# Usar entrypoint HTTP (web) para que traefik healthcheck --ping funcione
# (websecure requiere TLS + SNI válido, causando 404 con sniStrict: true)
ping:
  entryPoint: web

# Metrics
metrics:
  prometheus:
    entryPoint: metrics

# TLS Options
tls:
  options:
    default:
      minVersion: VersionTLS12
      cipherSuites:
        - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305
        - TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305
      sniStrict: true
    
    modern:
      minVersion: VersionTLS13

# Servidores de transporte (para backends internos)
serversTransport:
  insecureSkipVerify: false
  maxIdleConnsPerHost: 100
