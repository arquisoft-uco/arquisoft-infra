# Traefik Dynamic Configuration for Arquisoft
# =============================================
# TEMPLATE - NO editar dynamic.yaml directamente
# Editar dynamic.yaml.template y ejecutar start.sh
# Variables: ${DOMAIN} se reemplaza con valor de .env
# =============================================

http:
  # ============================================
  # ROUTERS
  # ============================================
  routers:
    # API Backend
    arquisoft-api:
      rule: "Host(`${DOMAIN}`) && PathPrefix(`/api`)"
      entryPoints:
        - web
        - websecure
      service: arquisoft-backend
      tls: {}
      middlewares:
        - api-stripprefix
        - rate-limit
        - security-headers

    # Frontend (cuando esté disponible)
    arquisoft-frontend:
      rule: "Host(`${DOMAIN}`)"
      entryPoints:
        - web
        - websecure
      service: arquisoft-frontend
      tls: {}
      middlewares:
        - security-headers
      priority: 1

    # Keycloak
    keycloak:
      rule: "Host(`auth.${DOMAIN}`)"
      entryPoints:
        - web
        - websecure
      service: keycloak
      tls: {}

    # MinIO Console
    minio-console:
      rule: "Host(`storage.${DOMAIN}`)"
      entryPoints:
        - web
        - websecure
      service: minio-console
      tls: {}
      middlewares:
        - auth-basic

    # MinIO API
    minio-api:
      rule: "Host(`s3.${DOMAIN}`)"
      entryPoints:
        - web
        - websecure
      service: minio-api
      tls: {}

    # Grafana
    grafana:
      rule: "Host(`grafana.${DOMAIN}`)"
      entryPoints:
        - web
        - websecure
      service: grafana
      tls: {}

    # RabbitMQ Management
    rabbitmq:
      rule: "Host(`rabbitmq.${DOMAIN}`)"
      entryPoints:
        - web
        - websecure
      service: rabbitmq-management
      tls: {}
      middlewares:
        - auth-basic

  # ============================================
  # SERVICES
  # ============================================
  services:
    arquisoft-backend:
      loadBalancer:
        servers:
          - url: "http://host.docker.internal:8080"
        healthCheck:
          path: /actuator/health
          interval: "10s"
          timeout: "3s"

    arquisoft-frontend:
      loadBalancer:
        servers:
          - url: "http://host.docker.internal:3000"

    keycloak:
      loadBalancer:
        servers:
          - url: "http://keycloak:8080"

    minio-console:
      loadBalancer:
        servers:
          - url: "http://minio:9001"

    minio-api:
      loadBalancer:
        servers:
          - url: "http://minio:9000"

    grafana:
      loadBalancer:
        servers:
          - url: "http://grafana:3000"

    rabbitmq-management:
      loadBalancer:
        servers:
          - url: "http://rabbitmq:15672"

  # ============================================
  # MIDDLEWARES
  # ============================================
  middlewares:
    # Strip /api prefix
    api-stripprefix:
      stripPrefix:
        prefixes:
          - "/api"

    # Rate limiting
    rate-limit:
      rateLimit:
        average: 100
        burst: 50
        period: 1s

    # Security headers
    security-headers:
      headers:
        frameDeny: true
        browserXssFilter: true
        contentTypeNosniff: true
        referrerPolicy: "strict-origin-when-cross-origin"
        customResponseHeaders:
          X-Powered-By: ""

    # Basic auth for admin panels
    # Credenciales en archivo externo (NO versionado)
    # Generar: htpasswd -c ../certs/.htpasswd admin
    auth-basic:
      basicAuth:
        usersFile: "/etc/traefik/certs/.htpasswd"
        removeHeader: true

    # Compress responses
    compress:
      compress: {}

    # CORS for API
    cors:
      headers:
        accessControlAllowMethods:
          - GET
          - POST
          - PUT
          - DELETE
          - OPTIONS
        accessControlAllowHeaders:
          - Content-Type
          - Authorization
          - X-Requested-With
        accessControlAllowOriginList:
          - "http://${DOMAIN}"
          - "https://${DOMAIN}"
        accessControlMaxAge: 100
        addVaryHeader: true

